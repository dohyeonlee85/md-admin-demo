# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)에서 복사한 값을 넣습니다.
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. 값을 비워 두면 "로컬 데모 모드"로 실행됩니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=md-admin-demo-292bb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=md-admin-demo-292bb
VITE_FIREBASE_APP_ID=

# 관리자 계정 이메일 (firestore.rules 의 이메일과 같아야 함)
VITE_ADMIN_EMAIL=
# 체험(조회) 계정: 읽기 전용이라 화면 코드에 포함되어도 안전
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
