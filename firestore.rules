rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 아래 이메일을 실제 관리자 계정 이메일로 바꿉니다.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE';
    }
    // 재고 변경 이력: 추가만 가능, 내용 수정 불가 (삭제는 데모 자료 초기화용으로만 허용)
    match /inventoryLogs/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
    }
    match /{col}/{id} {
      allow read: if request.auth != null;                    // 로그인한 계정만 조회
      allow write: if isAdmin() && col != 'inventoryLogs';    // 관리자만 저장·수정
    }
  }
}
